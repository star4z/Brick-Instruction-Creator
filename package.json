{
  "name": "brick-instruction-creator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Opinionated, fully customizable LEGO instruction manual creator for BrickLink Studio (.io) and LDraw (.ldr/.mpd) models",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-neocities.mjs",
    "build:no-check": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop",
    "test:e2e:mobile": "playwright test --project=mobile",
    "check:neocities": "node scripts/check-neocities.mjs",
    "detect:design": "impeccable detect src/",
    "detect:design:dist": "impeccable detect dist/index.html"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.25.0",
    "idb": "^8.0.2",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^22.14.0",
    "impeccable": "^4.10.0",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.5",
    "vitest": "^3.1.1"
  }
}
